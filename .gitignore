# macOS
.DS_Store

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets
.env
*.pem
*.key

# The benchmark streams the dataset from the Hub; nothing local is required.
data/
.cache/

# Scratch copies of the published Hub cards, pulled with `hf download` for
# editing. They live in the dataset and model repositories, not here.
hf-card/
hf-model-card/

# Benchmark output. Results are committed deliberately, one at a time, not by
# a bulk `git add` -- a results file records the commit that produced it, so
# sweeping them in alongside code changes makes that record a lie.
results/**/*.npz

# Experiments and models
outputs/
checkpoints/
wandb/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin

# IDE
.vscode/
.idea/
reports/local/
.coverage
coverage.xml
htmlcov/
